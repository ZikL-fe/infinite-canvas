PORT=3001
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5432/infinite_canvas
JWT_SECRET=please-change-this-to-a-long-random-secret
# 可选：独立加密密钥，用于加密存储在数据库中的对象存储密钥等敏感信息；未填则基于 JWT_SECRET 派生
SETTINGS_ENCRYPTION_KEY=
# 可选：Access Token 有效期（秒，默认 7200）与 Refresh Token 有效期（天，默认 30）
JWT_ACCESS_EXPIRES_SECONDS=7200
JWT_REFRESH_EXPIRES_DAYS=30
# 可选：对象存储预签名 URL 有效期（秒，默认 900）
S3_PRESIGN_EXPIRES_SECONDS=900
# 可选：允许跨域的前端地址，多个用英文逗号分隔；同源反代部署可留空
CORS_ORIGIN=http://localhost:3000

# 可选：对象存储环境变量默认配置（也可启动后在 /admin 后台可视化配置）
S3_PROVIDER=r2
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_BASE_URL=
S3_FORCE_PATH_STYLE=false

# 可选：高并发与内存保护调优参数（默认按 6H12G 单机配置）
DB_POOL_MAX=40
DB_IDLE_TIMEOUT_SECONDS=20
DB_CONNECT_TIMEOUT_SECONDS=10
SETTINGS_CACHE_TTL_MS=10000
MEDIA_PERSIST_CONCURRENCY=12
MEDIA_FETCH_TIMEOUT_MS=60000
MEDIA_PERSIST_MAX_BYTES=104857600
AI_PROXY_MAX_CONCURRENCY=120
AI_PROXY_MAX_QUEUE=300
AI_PROXY_QUEUE_WAIT_MS=30000
AI_UPSTREAM_TIMEOUT_MS=300000
AI_POLL_TIMEOUT_MS=30000
