# PostgreSQL 数据库密码（请务必修改为强密码）
POSTGRES_PASSWORD=please-change-pg-password

# PostgreSQL 数据库名称
POSTGRES_DB=infinite_canvas

# JWT 登录签发密钥（至少 16 位随机字符串，请务必修改）
JWT_SECRET=please-change-this-to-a-long-random-secret-key

# 可选：服务端加密后台渠道 Key / S3 / SMTP / WebDAV 等敏感配置的主密钥（建议 32 位以上随机字符串；修改后已加密配置需重新保存）
SETTINGS_ENCRYPTION_KEY=

# 可选：网站统计分析（按需取消注释并填入对应 ID）
# ANALYTICS_GA4_ID=
# ANALYTICS_BAIDU_ID=
